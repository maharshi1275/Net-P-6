
@model Product_Catelog.Models.Product

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@Model.ProductName | Product Catalog</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #fff8f1;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            color: #33251c;
        }

        .header {
            background: linear-gradient(135deg, #ff7a18, #e94e0b);
            color: white;
            padding: 28px 20px;
            text-align: center;
            margin-bottom: 40px;
        }

            .header h1 {
                font-weight: 700;
                margin: 0;
            }

        .product-card {
            background: white;
            border-radius: 18px;
            padding: 30px;
            max-width: 900px;
            margin: auto;
            box-shadow: 0 8px 30px rgba(100, 55, 25, 0.10);
        }

        .product-image {
            width: 100%;
            max-width: 400px;
            height: 300px;
            object-fit: contain;
            border-radius: 14px;
            background: #fff8f1;
            padding: 12px;
        }

        .product-info {
            padding: 10px;
        }

            .product-info p {
                font-size: 16px;
                padding: 13px 15px;
                margin-bottom: 12px;
                background: #fff5eb;
                border-radius: 9px;
            }

            .product-info strong {
                color: #61351f;
            }

        .price {
            color: #e65c0b;
            font-size: 24px;
            font-weight: bold;
        }

        .category {
            background: #ffead8;
            color: #a33e08;
            padding: 6px 10px;
            border-radius: 15px;
        }

        .back-btn {
            background: #f46b16;
            border: none;
            border-radius: 22px;
            padding: 10px 22px;
            margin-top: 12px;
        }

            .back-btn:hover {
                background: #cc4d08;
            }
    </style>
</head>

<body>

    <div class="header">
        <h1>🛒 Product Details</h1>
    </div>

    <div class="container pb-5">
        <div class="product-card">

            <div class="row align-items-center g-4">

                <div class="col-md-6 text-center">
                    <img src="@Model.ImageUrl"
                         class="product-image"
                         alt="@Model.ProductName" />
                </div>

                <div class="col-md-6 product-info">

                    <h2 class="mb-4">@Model.ProductName</h2>

                    <p>
                        <strong>Product ID:</strong>
                        @Model.ProductId
                    </p>

                    <p>
                        <strong>Product Name:</strong>
                        @Model.ProductName
                    </p>

                    <p>
                        <strong>Category:</strong>
                        <span class="badge category">
                            @Model.ProductCategory
                        </span>
                    </p>

                    <p>
                        <strong>Price:</strong>
                        <span class="price">
                            ₹@Model.ProductPrice.ToString("N0")
                        </span>
                    </p>

                    @Html.ActionLink(
                        "← Back to Products",
                        "Index",
                        "Products",
                        null,
                        new
                             {
                            @class = "btn btn-primary back-btn"
                        }
                    )

                </div>
            </div>
        </div>
    </div>

</body>
</html>
