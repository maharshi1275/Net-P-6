
@model List<Product_Catelog.Models.Product>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Product Catalog</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #fff8f1;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            color: #33251c;
        }

        .header {
            background: linear-gradient(135deg, #ff7a18, #e94e0b);
            color: white;
            padding: 35px 20px;
            text-align: center;
            margin-bottom: 40px;
            box-shadow: 0 5px 18px rgba(180, 75, 15, 0.18);
        }

            .header h1 {
                font-weight: 700;
                margin-bottom: 8px;
            }

            .header p {
                margin: 0;
                opacity: 0.95;
            }

        .catalog-card {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(100, 55, 25, 0.08);
        }

        .table {
            margin-bottom: 0;
            vertical-align: middle;
        }

            .table thead th {
                background: #fff0e2;
                color: #8f3d0b;
                padding: 15px;
                border-bottom: 2px solid #ffd3ad;
            }

            .table tbody td {
                padding: 15px;
            }

            .table tbody tr:hover {
                background: #fff8f1;
            }

        .price {
            color: #d9550b;
            font-size: 17px;
            font-weight: bold;
        }

        .category {
            background: #ffead8;
            color: #a33e08;
            padding: 7px 11px;
            border-radius: 20px;
        }

        .details-btn {
            background: #f46b16;
            border: none;
            border-radius: 20px;
            padding: 7px 18px;
        }

            .details-btn:hover {
                background: #cc4d08;
            }

        .product-count {
            background: #f46b16;
        }

        .footer {
            text-align: center;
            margin-top: 40px;
            padding: 20px;
            color: #987d69;
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>🛍️ Product Catalog</h1>
        <p>Quality products for everyday life</p>
    </div>

    <div class="container">
        <div class="catalog-card">

            <div class="d-flex justify-content-between
                        align-items-center mb-4">
                <div>
                    <h3 class="mb-1">Our Collection</h3>
                    <p class="text-muted mb-0">
                        Find the right product for you
                    </p>
                </div>

                <span class="badge product-count rounded-pill px-3 py-2">
                    @Model.Count Products
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th class="text-center">Details</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@i.ProductName</strong>
                                </td>

                                <td>
                                    <span class="badge category">
                                        @i.ProductCategory
                                    </span>
                                </td>

                                <td class="price">
                                    ₹@i.ProductPrice.ToString("N0")
                                </td>

                                <td class="text-center">
                                    @Html.ActionLink(
                                        "View Details",
                                        "Details",
                                        "Products",
                                        new { id = i.ProductId },
                                        new
                                             {
                                            @class = "btn btn-primary btn-sm details-btn"
                                        }
                                    )
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <div class="footer">
        <p>© 2026 Product Catalog | MVC Application</p>
    </div>

</body>
</html>
